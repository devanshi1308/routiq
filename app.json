{
  "expo": {
    "name": "Routiq",
    "slug": "routiq",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "routiq",
    "userInterfaceStyle": "automatic",
    "ios": {
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "bundleIdentifier": "com.routiq.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Routiq records ride audio on your phone only when you start a recording.",
        "NSLocationWhenInUseUsageDescription": "Routiq uses your location to find rides near you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.routiq.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Routiq",
      "shortName": "Routiq",
      "backgroundColor": "#000000",
      "themeColor": "#000000"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://routiq.app/"
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Routiq uses your location to find rides near you."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Routiq records ride audio on your phone only when you start a recording."
        }
      ],
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#000000"
        }
      ],
      "expo-asset",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "description": "Routiq: book autos, bikes and cabs, track your ride live and share it with people you trust.",
    "extra": {
      "router": {
        "origin": "https://routiq.app/"
      },
      "eas": {
        "projectId": "3dd24811-5310-4417-b1f1-a5301d1e863a"
      }
    },
    "owner": "deva13",
    "runtimeVersion": "2.0.0",
    "updates": {
      "url": "https://u.expo.dev/3dd24811-5310-4417-b1f1-a5301d1e863a"
    }
  }
}