{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "main",
      "env": {
        "EXPO_PUBLIC_DEMO": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  }
}